---

<BaseLayout
  title={title}
  description={description}
  keywords="Clown Kindergeburtstag NRW, Zauberer Kindergeburtstag, Clown Zauberer NRW, Zaubershow Kinder, Kinderzauberer NRW, Clown buchen NRW, Kindergeburtstag Zauberer"
  canonical="https://liar-entertainer.com/"
  ogImage={ogImage}
  structuredData={[faqSchema, personSchema, videoSchema]}
  heroPreload={heroOptimized.src}
>

  <style>
    /* Startseite: Content-Texte auf 17px */
    section p:not([class*="text-xs"]):not([class*="text-sm"]):not([class*="uppercase"]),
    section li,
    section dd { font-size: 17px; }
  </style>

  <!-- ═══════════════════════════════════════
       HERO – gerundete Bild-Karte im Container + Pill-Badges
       (umschlossen von .hero-stage für ruhige Pastell-Blobs)
  ════════════════════════════════════════ -->
  <div class="hero-stage relative overflow-hidden">
    <div class="hero-blobs" aria-hidden="true">
      <span class="blob blob-red"></span>
      <span class="blob blob-blue"></span>
      <span class="blob blob-gold"></span>
    </div>
    <div class="hero-sparkles" aria-hidden="true">
      <span class="spark" style="top:10%; left:7%;">✦</span>
      <span class="spark" style="top:5%; left:40%;">✧</span>
      <span class="spark" style="top:14%; right:9%;">✦</span>
      <span class="spark" style="top:60%; left:5%;">✧</span>
      <span class="spark" style="top:66%; right:7%;">✦</span>
    </div>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-wrap justify-center gap-3 mb-5">
        <span class="hero-badge inline-flex items-center gap-1.5 bg-[#fdf2f2] text-[#1f2025] text-sm font-semibold px-4 py-1.5 rounded-full border border-[#f0c4c4]">
          <span class="text-[#e69420]">★★★★★</span> 400+ Google-Rezensionen
        </span>
        <span class="hero-badge inline-flex items-center gap-1.5 bg-[#eff4ff] text-[#1f2025] text-sm font-semibold px-4 py-1.5 rounded-full border border-[#c5d3f7]">
          🎩 15 Jahre Erfahrung
        </span>
        <span class="hero-badge inline-flex items-center gap-1.5 bg-[#fdf2f2] text-[#1f2025] text-sm font-semibold px-4 py-1.5 rounded-full border border-[#f0c4c4]">
          🪄 Interaktive Zaubershow
        </span>
      </div>
      <div class="hero-slider" role="region" aria-roledescription="Bildergalerie" aria-label="Eindrücke von LIARs Shows">
        {heroSlides.map((slide, i) => (
          <Image
            src={slide.src}
            alt={slide.alt}
            class:list={["hero-slide", { "is-active": i === 0 }]}
            loading="eager"
            fetchpriority={i === 0 ? "high" : "auto"}
            widths={[600, 900, 1200]}
            sizes="(max-width: 1152px) 100vw, 1120px"
            quality={70}
          />
        ))}
        <div class="hero-dots">
          {heroSlides.map((_, i) => (
            <button type="button" class:list={["hero-dot", { "is-active": i === 0 }]} data-i={i} aria-label={`Bild ${i + 1} anzeigen`}></button>
          ))}
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var root = document.querySelector('.hero-slider');
      if (!root) return;
      var slides = root.querySelectorAll('.hero-slide');
      var dots = root.querySelectorAll('.hero-dot');
      if (slides.length < 2) return;
      var i = 0, timer = null;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function show(n) {
        i = (n + slides.length) % slides.length;
        slides.forEach(function (s, k) { s.classList.toggle('is-active', k === i); });
        dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); });
      }
      function next() { show(i + 1); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() { if (reduce) return; stop(); timer = setInterval(next, 3000); }
      dots.forEach(function (d) {
        d.addEventListener('click', function () { show(parseInt(d.dataset.i, 10)); start(); });
      });
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
      start();
    })();
  </script>

  <!-- ═══════════════════════════════════════
       INTRO – H1 + lead paragraph (centered)
  ════════════════════════════════════════ -->
