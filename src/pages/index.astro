  <script>
    // Scroll-Reveal mit Stagger für Karten-Grids (progressive enhancement:
    // Styles werden erst per JS gesetzt — ohne JS bleibt alles sichtbar).
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const EASE = 'cubic-bezier(0.23, 1, 0.32, 1)';
      const groups = document.querySelectorAll('[data-reveal-group]');
      const items: HTMLElement[] = [];
      groups.forEach((group) => {
        Array.from(group.children).forEach((child, i) => {
          const el = child as HTMLElement;
          el.style.opacity = '0';
          el.style.transform = 'translateY(14px)';
          el.style.transition = `opacity 450ms ${EASE} ${i * 60}ms, transform 450ms ${EASE} ${i * 60}ms`;
          items.push(el);
        });
      });
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
              io.unobserve(el);
            }
          });
        },
        { rootMargin: '0px 0px -60px 0px' }
      );
      items.forEach((el) => io.observe(el));
    }
  </script>

