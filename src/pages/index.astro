---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { Image, getImage } from 'astro:assets';

import heroCutout from '../assets/images/home/liar-freisteller-hero.png';
const heroOptimized = await getImage({ src: heroCutout, width: 900, format: 'webp' });
import portraitImg from '../assets/images/home/clown-zauberer-liar-portrait.jpg';
import michaelImg from '../assets/images/home/michael-prescler-portrait.jpg';
import clownerieImg from '../assets/images/home/clownerie-und-zauberei.jpg';
import zaubershowImg from '../assets/images/shows/zaubershow.jpg';
import ballonImg from '../assets/images/shows/ballonmodellage.jpg';
import glitzerImg from '../assets/images/shows/glitzer-tattoos.jpg';
import karteImg from '../assets/images/home/clown-zauberer-gladbeck-karte.jpg';

const title = 'Clown Zauberer NRW | Kindergeburtstag & Events | LIAR';
const description = 'Clown Zauberer LIAR in NRW ✓ Zaubershow & Clownshow ✓ Kindergeburtstag & Events ✓ 400+ Top-Bewertungen ✓ Ballonmodellage & Glitzer-Tattoos ✓ Jetzt buchen!';
const ogImage = 'https://liar-entertainer.com/images/og-startseite.jpg';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Clown für Kindergeburtstag?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ich arbeite mit transparenten Festpreisen ohne versteckte Kosten. Alle Pakete und Preise für den Kindergeburtstag finden Sie auf der Kindergeburtstag-Seite – für andere Anlässe erstelle ich Ihnen gern ein individuelles Angebot."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Zauberer für einen Kindergeburtstag?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ich arbeite mit transparenten Festpreisen ohne versteckte Kosten. Alle Pakete und Preise für den Kindergeburtstag finden Sie auf der Kindergeburtstag-Seite – für andere Anlässe erstelle ich Ihnen gern ein individuelles Angebot."
      }
    },
    {
      "@type": "Question",
      "name": "Macht Clown LIAR auch eine reine Zaubershow für Kinder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Neben der Kombination aus Clownerie und Magie bietet LIAR auch eine reine Zaubershow für Kinder an – ideal für Kindergeburtstage, Kitas, Schulen und Sommerfeste. Die Kinder machen aktiv mit und werden selbst zu kleinen Zauberern. Die Show dauert ca. 40 Minuten und ist für Kinder von 3 bis 12 Jahren geeignet."
      }
    },
    {
      "@type": "Question",
      "name": "In welchen Städten ist Clown LIAR buchbar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Clown LIAR ist in ganz NRW buchbar, insbesondere in Gladbeck, Oberhausen, Essen, Gelsenkirchen, Dortmund, Bochum, Duisburg und weiteren Städten."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert eine Clown Zaubershow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Standard-Zaubershow dauert ca. 40 Minuten und ist speziell auf Kinder von 3-12 Jahren zugeschnitten."
      }
    },
    {
      "@type": "Question",
      "name": "Wie läuft die Buchung von Clown Zauberer LIAR ab?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Buchung ist einfach: Sie senden eine Anfrage über das Kontaktformular oder rufen direkt unter 0172-1517578 an. Nach Abstimmung von Datum, Ort und gewünschter Show erhalten Sie eine verbindliche Bestätigung. Eine Anfrage 2-4 Wochen im Voraus wird empfohlen, kurzfristige Termine sind aber oft möglich."
      }
    },
    {
      "@type": "Question",
      "name": "Ist Clown LIAR ein \"gruseliger\" Clown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein! Clown LIAR tritt bewusst ohne Schminke, ohne rote Nase und ohne \"komische Haare\" auf. Sein Clown-Charakter ist freundlich, bunt und einladend. Selbst schüchterne Kinder tauen schnell auf."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich Clown LIAR auch für Erwachsenen-Events buchen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja! Neben Kindergeburtstagen bietet Clown Zauberer LIAR auch Close-up Zauberei für Hochzeiten, Firmenfeiern und Gala-Events an. Die Tischzauberei funktioniert ohne Bühne direkt an den Tischen Ihrer Gäste."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit im Voraus sollte ich buchen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eine Anfrage mindestens 2-4 Wochen im Voraus wird empfohlen, besonders an Wochenenden. Kurzfristige Buchungen sind aber oft auch möglich – einfach unter 0172-1517578 anrufen!"
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich eine Bühne oder spezielle Technik?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein! Es werden nur 2×2 Meter Platz benötigt. Die Show funktioniert im Wohnzimmer, Garten, Turnhalle oder auf einer Bühne. Alles Nötige wird mitgebracht."
      }
    },
    {
      "@type": "Question",
      "name": "Für welches Alter ist die Show geeignet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Shows sind für Kinder von 3 bis 12 Jahren konzipiert. Das Programm wird immer an die Altersgruppe angepasst: einfacher und kürzer für Kindergartenkinder, anspruchsvoller für Grundschulkinder."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Sprachen spricht Clown Zauberer LIAR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Clown Zauberer LIAR moderiert seine Shows auf Deutsch und Französisch. Dadurch sind auch zweisprachige Events und internationale Feiern in NRW und im Grenzgebiet problemlos möglich."
      }
    },
    {
      "@type": "Question",
      "name": "Was passiert bei schlechtem Wetter (Outdoor-Event)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Show ist flexibel und funktioniert drinnen wie draußen. Falls ein Outdoor-Event wegen Regen ins Haus verlegt werden muss, ist das kein Problem – es werden nur 2×2 Meter Platz benötigt."
      }
    },
    {
      "@type": "Question",
      "name": "Hat Clown LIAR eine Versicherung und ein Führungszeugnis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, Clown Zauberer LIAR ist vollständig haftpflichtversichert und verfügt über ein aktuelles polizeiliches Führungszeugnis, das auf Anfrage vorgelegt wird."
      }
    }
  ]
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Michaël Prescler",
  "alternateName": "Clown Zauberer LIAR",
  "jobTitle": "Professioneller Clown & Zauberer",
  "description": "Professioneller Kinderzauberer und Clown mit über 15 Jahren Erfahrung und pädagogischer Ausbildung in NRW",
  "knowsAbout": ["Zauberei", "Clownerie", "Kinderunterhaltung", "Ballonmodellage", "Close-up Magie"],
  "knowsLanguage": ["de", "fr"],
  "worksFor": {
    "@type": "LocalBusiness",
    "name": "Clown Zauberer LIAR",
    "url": "https://liar-entertainer.com"
  },
  "url": "https://liar-entertainer.com"
};
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow und Clownshow für Kinder in NRW. Kindergeburtstage und Events – professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": {
    "@type": "Organization",
    "name": "Clown Zauberer LIAR",
    "url": "https://liar-entertainer.com"
  }
};
---

<BaseLayout
  title={title}
  description={description}
  keywords="Clown Kindergeburtstag NRW, Zauberer Kindergeburtstag, Clown Zauberer NRW, Zaubershow Kinder, Kinderzauberer NRW, Clown buchen NRW, Kindergeburtstag Zauberer"
  canonical="https://liar-entertainer.com/"
  ogImage={ogImage}
  structuredData={[faqSchema, personSchema, videoSchema]}
  heroPreload={heroOptimized.src}
>

  <style is:global>
    /* Pill-Navigation im Conferism-Stil — CSS liegt im Startseiten-Bundle,
       Unterseiten behalten den klassischen Header unverändert. */
    #main-nav {
      max-width: 72rem;
      margin: 0.9rem auto 0.25rem;
      border: 1px solid rgba(255, 255, 255, 0.85);
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 10px 34px rgba(31, 32, 37, 0.10);
      overflow: visible;
    }
    #main-nav.fixed { left: 50% !important; right: auto !important; transform: translateX(-50%); width: min(72rem, calc(100% - 1.5rem)); top: 0.5rem !important; }
    #nav-desktop-row { height: 3.25rem; }
    /* Kontakt-Link als roter Pill-CTA (letzter Menüpunkt) */
    #nav-desktop-row > a:last-child {
      background: #d7393e;
      color: #ffffff;
      border-radius: 9999px;
      height: auto;
      padding: 0.5rem 1.25rem;
      margin-left: 0.6rem;
      font-weight: 700;
    }
    #nav-desktop-row > a:last-child:hover { background: #b62e32; color: #ffffff; }
    /* Dropdowns bekommen weiche Conferism-Rundung */
    #main-nav .dropdown-menu { border-radius: 1rem; overflow: hidden; box-shadow: 0 16px 44px rgba(31,32,37,.14); }
    /* Mobile-Menü darf nicht rund abgeschnitten werden */
    @media (max-width: 899px) {
      #main-nav { border-radius: 1.25rem; }
    }

    /* Conferism-Farbwelt (nur Startseite): kräftige ROT/BLAU-Pastelle statt
       blassem Rosa — deutlich mehr Kontrast + durchgehende Verläufe. */
    .hero-stage {
      background:
        radial-gradient(70% 90% at 8% 0%, rgba(215, 57, 62, 0.22) 0%, rgba(215, 57, 62, 0) 55%),
        radial-gradient(70% 90% at 92% 0%, rgba(59, 85, 213, 0.24) 0%, rgba(59, 85, 213, 0) 55%),
        radial-gradient(90% 60% at 50% 108%, rgba(215, 57, 62, 0.14) 0%, rgba(215, 57, 62, 0) 60%),
        linear-gradient(180deg, #ffffff 0%, #fef6f6 40%, #f3f6ff 75%, #ffffff 100%) !important;
    }
    .hero-blobs .blob-red {
      background: radial-gradient(circle at 35% 35%, rgba(244, 150, 154, 0.85) 0%, rgba(244, 150, 154, 0) 70%) !important;
    }
    .hero-blobs .blob-blue {
      background: radial-gradient(circle at 65% 35%, rgba(150, 172, 244, 0.85) 0%, rgba(150, 172, 244, 0) 70%) !important;
    }
    .hero-blobs .blob-gold {
      background: radial-gradient(circle at 50% 50%, rgba(255, 200, 120, 0.55) 0%, rgba(255, 200, 120, 0) 70%) !important;
    }
    .hero-blobs .blob { opacity: 1 !important; filter: blur(70px); }
  </style>
  <style>
    /* Startseite: Content-Texte auf 17px */
    section p:not([class*="text-xs"]):not([class*="text-sm"]):not([class*="uppercase"]),
    section li,
    section dd { font-size: 17px; }
  </style>

  <!-- ═══════════════════════════════════
       HERO – gerundete Bild-Karte im Container + Pill-Badges
       (umschlossen von .hero-stage für ruhige Pastell-Blobs)
  ════════════════════════════════════ -->
  <div class="hero-stage relative overflow-hidden">
    <div class="hero-blobs" aria-hidden="true">
      <span class="blob blob-red"></span>
      <span class="blob blob-blue"></span>
      <span class="blob blob-gold"></span>
    </div>
    <div class="hero-sparkles" aria-hidden="true">
      <span class="spark" style="top:10%; left:7%;">✦</span>
      <span class="spark" style="top:5%; left:40%;">✧</span>
      <span class="spark" style="top:14%; right:9%;">✦</span>
      <span class="spark" style="top:60%; left:5%;">✧</span>
      <span class="spark" style="top:66%; right:7%;">✦</span>
    </div>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-wrap justify-center gap-3 mb-5">
        <span class="hero-badge inline-flex items-center gap-1.5 bg-white/90 text-[#1f2025] text-sm font-semibold px-4 py-1.5 rounded-full border-2 border-[#f0a9ab] shadow-sm">
          <span class="text-[#e69420]">★★★★★</span> 400+ Google-Rezensionen
        </span>
        <span class="hero-badge inline-flex items-center gap-1.5 bg-white/90 text-[#1f2025] text-sm font-semibold px-4 py-1.5 rounded-full border-2 border-[#a9bcf0] shadow-sm">
          🎩 15 Jahre Erfahrung
        </span>
        <span class="hero-badge inline-flex items-center gap-1.5 bg-white/90 text-[#1f2025] text-sm font-semibold px-4 py-1.5 rounded-full border-2 border-[#f0a9ab] shadow-sm">
          🪄 Interaktive Zaubershow
        </span>
      </div>
      <!-- Conferism-Hero: Freisteller mittig, Riesen-Headline links/rechts gesplittet -->
      <div class="conf-hero">
        <h1 class="conf-h1">
          <span class="conf-word conf-word-left text-[#d7393e]">Clown Zauberer</span>
          <span class="conf-word conf-word-right text-[#1f2025]">in NRW</span>
          <span class="conf-sub text-[#374151]">– Zaubershow &amp; Kindergeburtstag</span>
        </h1>
        <div class="conf-img-wrap">
          <Image
            src={heroCutout}
            alt="Clown Zauberer LIAR – freigestelltes Portrait im Kostüm"
            class="conf-img"
            loading="eager"
            fetchpriority="high"
            widths={[380, 520, 760]}
            sizes="(max-width: 640px) 70vw, 460px"
            quality={85}
          />
        </div>
        <div class="conf-btns">
          <a href="/kontakt/" class="inline-block bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold px-7 py-3.5 rounded-full text-base transition-colors shadow-lg">
            Jetzt unverbindlich anfragen
          </a>
          <a href="tel:+491721517578" class="inline-flex items-center gap-2 bg-[#1f2025] hover:bg-black text-white font-bold px-6 py-3.5 rounded-full text-base transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#ffb546" class="w-5 h-5" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
            0172 1517578
          </a>
        </div>
      </div>
    </div>
  </section>
  <style>
    /* Conferism-Hero: Grid [Text | Freisteller | Text], Headline umfließt die Figur */
    .conf-hero {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas:
        "left img right"
        "sub  sub sub"
        "btns btns btns";
      align-items: center;
      column-gap: 1rem;
      margin-top: 1.5rem;
    }
    .conf-h1 { display: contents; }
    .conf-word {
      font-weight: 800;
      text-transform: uppercase;
      line-height: 0.95;
      letter-spacing: -0.01em;
      font-size: clamp(2.1rem, 5.6vw, 4.6rem);
    }
    .conf-word-left { grid-area: left; text-align: right; align-self: end; padding-bottom: 3rem; }
    .conf-word-right { grid-area: right; text-align: left; align-self: end; padding-bottom: 6.5rem; }
    .conf-sub {
      grid-area: sub;
      text-align: center;
      font-size: clamp(1.05rem, 2vw, 1.4rem);
      font-weight: 600;
      margin-top: 0.75rem;
    }
    .conf-img-wrap { grid-area: img; display: flex; justify-content: center; }
    .conf-img {
      width: clamp(300px, 44vw, 600px);
      height: auto;
      filter: drop-shadow(0 24px 48px rgba(31, 32, 37, 0.22));
    }
    .conf-btns {
      grid-area: btns;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
      margin-top: 1.5rem;
    }
    @media (max-width: 639px) {
      .conf-hero {
        grid-template-columns: 1fr;
        grid-template-areas: "img" "left" "right" "sub" "btns";
        row-gap: 0.25rem;
      }
      .conf-word-left, .conf-word-right { text-align: center; padding-bottom: 0; }
    }
  </style>
  <!-- ═══════════════════════════════════
       INTRO – Lead paragraph
  ════════════════════════════════════ -->
  <section class="py-14 md:py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-[#1f2025] font-extrabold text-2xl sm:text-3xl leading-tight mb-6">
        <span class="text-[#d7393e]">Lachen garantiert</span> – bei Ihnen zu Hause, in der Kita oder auf dem Fest
      </h2>
      <p class="hero-subtitle text-[#374151] text-[17px] sm:text-lg leading-relaxed">
        Sie suchen einen Clown, der Kinderaugen zum Leuchten bringt? Clown Zauberer Liar sorgt seit
        über 15 Jahren für unvergessliche Momente auf <a href="/kindergeburtstag/" class="text-[#d7393e] hover:underline">Kindergeburtstagen</a>, Straßenfesten und
        Firmenevents in ganz NRW. Als erfahrener <a href="/kinderzauberer/" class="text-[#d7393e] hover:underline font-semibold">Kinderzauberer</a> und
        <a href="/clown/clownshow/" class="text-[#d7393e] hover:underline font-semibold">Clown</a> verbindet er professionelle
        <a href="/zauberer/" class="text-[#d7393e] hover:underline font-semibold">Zauberei</a>
        mit Interaktion — jede Veranstaltung wird zum Highlight!
      </p>
      <div class="mt-8 text-center">
        <a href="/kontakt/" class="inline-block bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold px-10 py-4 rounded-full text-base transition-colors">
          Jetzt unverbindlich anfragen
        </a>
      </div>
    </div>
  </section>
  </div>

  <!-- ═══════════════════════════════════
       WAS MACHT CLOWN LIAR SO BESONDERS?
  ════════════════════════════════════ -->
  <section class="py-14" style="background: radial-gradient(60% 80% at 100% 20%, rgba(59,85,213,0.10) 0%, rgba(59,85,213,0) 60%), linear-gradient(180deg, #ffffff 0%, #fdf1f1 55%, #ffffff 100%);">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-[#d7393e] font-extrabold text-3xl sm:text-4xl mb-8 leading-tight">
        Was macht Clown Liar so besonders?
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div class="space-y-5">
          <p class="text-[#374151] leading-relaxed">
            Als professioneller Clown und Kinderzauberer bringe ich nicht nur Kinder, sondern auch Erwachsene zum Lachen.
            Meine Show kombiniert klassische Clownerie mit modernen Entertainment-&nbsp;Elementen –
            individuell abgestimmt auf Ihr Event und die Altersgruppe. Ob beim <a href="/kindergeburtstag/" class="text-[#d7393e] hover:underline">Kindergeburtstag</a> oder auf der großen Bühne.
          </p>
          <p class="text-[#374151] leading-relaxed">
            <a href="/zauberer/zaubershow/" class="text-[#d7393e] hover:underline font-semibold">Zaubershow</a>:
            Verblüffende Zaubertricks, bei denen die Kinder aktiv mitmachen und selbst zu
            kleinen Zauberern werden. Staunen und Lachen in perfekter Balance!
          </p>
          <p class="text-[#374151] leading-relaxed">
            <strong>Walk-Act:</strong> Lustige Improvisation, witzige Gags und interaktive Clownerie, die garantiert
            für Lacher sorgt. Jeder Pantomime- oder Clown-Auftritt wird auf Ihre Gäste abgestimmt.
          </p>
          <p class="text-[#374151] leading-relaxed">
            <strong>Extras:</strong> Ballonmodellage, Glitzer Tattoos, Close-up… Ihr Clown Zauberer bringt alles
            mit, was Ihr Event unvergesslich macht.
          </p>
        </div>
        <div class="flex justify-center lg:justify-end">
          <Image
            src={portraitImg}
            alt="Clown Zauberer LIAR bringt Kinder auf dem Geburtstag zum Lachen"
            class="rounded-2xl object-cover object-[20%] portrait-zoom"
            style="width:320px;height:320px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);"
            loading="lazy"
            width={320}
            height={320}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Google Reviews (dynamisch) -->
  <GoogleReviews />

  <!-- ═══════════════════════════════════
       LERNEN SIE CLOWN LIAR KENNEN
  ════════════════════════════════════ -->
  <section class="py-14" style="background: radial-gradient(55% 75% at 0% 60%, rgba(215,57,62,0.09) 0%, rgba(215,57,62,0) 60%), linear-gradient(180deg, #ffffff 0%, #eef3ff 60%, #ffffff 100%);">
    <div class="max-w-5xl mx-auto px-4">
      <p class="text-[#d7393e] font-bold text-sm uppercase tracking-widest mb-1">Über mich</p>
      <h2 class="text-[#1f2025] font-extrabold text-3xl sm:text-4xl mb-8 leading-tight">
        Lernen Sie Clown Liar kennen – Ihr Entertainer mit Herz &amp; Humor
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <p class="text-[#374151] leading-relaxed mb-4">
            Hallo, ich bin Liar – professioneller Clown, Zauberer und Entertainer aus
            Nordrhein-Westfalen und seit über einem Jahrzehnt bringe ich Kinderherzen zum
            Hüpfen und Erwachsene zum Schmunzeln. <a href="/ueber-mich/" class="text-[#d7393e] hover:underline">Erfahren Sie mehr über mich und meinen Werdegang</a>.
          </p>
          <p class="text-[#374151] leading-relaxed">
            Meine Mission? Jeden Moment zu etwas Besonderem machen! Daher ist es mir als
            Clown wichtig, dass sich jedes Kind gesehen und einbezogen fühlt. Deshalb sind
