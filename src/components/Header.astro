---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/general/logo-clown-nrw.png';

const navItems = [
  {
    label: 'Clown',
    href: '/clown/clownshow/',
    children: [
      { label: 'Clownshow', href: '/clown/clownshow/' },
      { label: 'Walk Act', href: '/clown/walk-act/' },
      { label: 'Ballonmodellage', href: '/clown/ballonmodellage/' },
      { label: 'Glitzer Tattoo', href: '/clown/glitzer-tattoo/' },
    ],
  },
  {
    label: 'Zauberer',
    href: '/zauberer/',
    children: [
      { label: 'Bühnen Zauberer', href: '/zauberer/buehnen-zauberer/' },
      { label: 'Tisch Zauberer', href: '/zauberer/tisch-zauberer/' },
    ],
  },
  { label: 'Kinderzauberer', href: '/kinderzauberer/' },
  { label: 'Kindergeburtstag', href: '/kindergeburtstag/' },
  { label: 'Preise', href: '/preise/' },
  {
    label: 'Zaubershow',
    href: '/zauberer/zaubershow/',
    children: [
      { label: 'Kindergarten – Kita', href: '/zauberer/zaubershow/kindergarten-kita/' },
      { label: 'Schule', href: '/zauberer/zaubershow/schule/' },
      { label: 'Straßen – Sommer -Fest', href: '/zauberer/zaubershow/strassen-sommer-fest/' },
      { label: 'Karneval', href: '/clown/karneval/' },
    ],
  },
  { label: 'Galerie', href: '/galerie/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Pantomime', href: 'https://pantomime.liar-entertainer.com', external: true },
];
---

<!-- ========================================================
     HEADER — Single compact bar: Logo | Nav | CTA
     ======================================================== -->
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 h-[68px] flex items-center gap-4">

    <!-- Logo + Brand Name -->
    <a href="/" aria-label="Startseite Clown Zauberer LIAR" class="flex items-center gap-3 flex-shrink-0">
      <Image
        src={logoImg}
        alt="LOGO Clown Zauberer LIAR"
        width={180}
        height={125}
        class="w-[52px] h-auto"
        loading="eager"
        fetchpriority="high"
      />
      <span class="hidden sm:block leading-tight">
        <span class="block text-[#1f2025] font-extrabold text-[15px] tracking-tight">LIAR</span>
        <span class="block text-[#595959] text-[11px] font-medium">Clown · Zauberer · NRW</span>
      </span>
    </a>

    <!-- Flex spacer pushes nav to center / CTA to right -->
    <div class="flex-1"></div>

    <!-- Desktop Nav (xl and up) -->
    <nav class="hidden xl:flex items-center h-full" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        item.children ? (
          <div class="relative h-full flex items-center nav-dropdown-wrap">
            <button
              class="flex items-center gap-1 px-3 h-full text-[#374151] hover:text-[#d7393e] text-[13px] font-medium transition-colors whitespace-nowrap"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.label}
              <svg class="w-3 h-3 transition-transform dropdown-chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="dropdown-menu absolute top-full left-0 w-52 bg-white shadow-xl border border-gray-100 rounded-xl py-2 z-50 hidden" role="menu">
              <a href={item.href} class="block px-4 py-2 text-[#374151] hover:bg-[#fdf2f2] hover:text-[#d7393e] transition-colors text-sm font-semibold rounded-lg mx-1" role="menuitem">
                Alle {item.label}
              </a>
              <div class="h-px bg-gray-100 mx-3 my-1"></div>
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-4 py-2 text-[#374151] hover:bg-[#fdf2f2] hover:text-[#d7393e] transition-colors text-sm rounded-lg mx-1"
                  role="menuitem"
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : item.external ? (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center px-3 h-full text-[#374151] hover:text-[#d7393e] text-[13px] font-medium transition-colors whitespace-nowrap"
          >
            {item.label}
          </a>
        ) : (
          <a
            href={item.href}
            class="flex items-center px-3 h-full text-[#374151] hover:text-[#d7393e] text-[13px] font-medium transition-colors whitespace-nowrap"
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- CTA Button -->
    <a
      href="/kontakt/"
      class="hidden lg:inline-flex items-center gap-2 bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold text-[13px] px-5 py-2.5 rounded-full transition-colors flex-shrink-0 ml-2"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      Termin anfragen
    </a>

    <!-- Mobile Hamburger -->
    <button
      id="mobile-menu-btn"
      class="xl:hidden text-[#1f2025] p-2 -mr-2 rounded-lg hover:bg-gray-100 transition-colors"
      aria-label="Navigationsmenü öffnen"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden bg-white border-t border-gray-100 shadow-lg max-h-[80vh] overflow-y-auto"
    role="dialog"
    aria-label="Mobilmenü"
  >
    <div class="px-4 py-3 space-y-1">
      {navItems.map((item) => (
        item.children ? (
          <div class="mobile-accordion">
            <button
              class="mobile-accordion-btn flex items-center justify-between w-full text-[#1f2025] hover:text-[#d7393e] px-3 py-3 text-[15px] font-semibold rounded-lg hover:bg-[#fdf2f2] transition-colors"
              aria-expanded="false"
            >
              {item.label}
              <svg class="w-4 h-4 transition-transform accordion-chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="mobile-accordion-content hidden pl-3 pb-1 space-y-0.5">
              <a href={item.href} class="block text-[#374151] hover:text-[#d7393e] hover:bg-[#fdf2f2] px-3 py-2 text-sm rounded-lg transition-colors">
                Alle {item.label}
              </a>
              {item.children.map((child) => (
                <a href={child.href} class="block text-[#374151] hover:text-[#d7393e] hover:bg-[#fdf2f2] px-3 py-2 text-sm rounded-lg transition-colors">
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : item.external ? (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-[#1f2025] hover:text-[#d7393e] hover:bg-[#fdf2f2] px-3 py-3 text-[15px] font-semibold rounded-lg transition-colors"
          >
            {item.label}
            <svg class="w-3.5 h-3.5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        ) : (
          <a href={item.href} class="block text-[#1f2025] hover:text-[#d7393e] hover:bg-[#fdf2f2] px-3 py-3 text-[15px] font-semibold rounded-lg transition-colors">
            {item.label}
          </a>
        )
      ))}
      <!-- Mobile CTA -->
      <div class="pt-3 pb-1">
        <a
          href="/kontakt/"
          class="flex items-center justify-center gap-2 bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold text-[15px] px-6 py-3 rounded-full transition-colors w-full"
        >
          Termin anfragen
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer: compensates for fixed header height -->
<div style="height: 68px;" aria-hidden="true"></div>

<script is:inline>
  // Desktop dropdown menus (hover)
  document.querySelectorAll('.nav-dropdown-wrap').forEach(function(wrap) {
    var menu = wrap.querySelector('.dropdown-menu');
    var chevron = wrap.querySelector('.dropdown-chevron');
    var btn = wrap.querySelector('button');
    if (!menu) return;
    wrap.addEventListener('mouseenter', function() {
      menu.classList.remove('hidden');
      chevron && chevron.classList.add('rotate-180');
      btn && btn.setAttribute('aria-expanded', 'true');
    });
    wrap.addEventListener('mouseleave', function() {
      menu.classList.add('hidden');
      chevron && chevron.classList.remove('rotate-180');
      btn && btn.setAttribute('aria-expanded', 'false');
    });
  });

  // Mobile hamburger toggle
  var mobileBtn = document.getElementById('mobile-menu-btn');
  var mobileMenu = document.getElementById('mobile-menu');
  var hamburgerIcon = document.getElementById('hamburger-icon');
  var closeIcon = document.getElementById('close-icon');

  if (mobileBtn) {
    mobileBtn.addEventListener('click', function() {
      var isOpen = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden', !isOpen);
      closeIcon.classList.toggle('hidden', isOpen);
      mobileBtn.setAttribute('aria-expanded', String(!isOpen));
    });
  }

  // Mobile accordion
  document.querySelectorAll('.mobile-accordion-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var content = btn.nextElementSibling;
      var chevron = btn.querySelector('.accordion-chevron');
      var isOpen = !content.classList.contains('hidden');
      content.classList.toggle('hidden');
      chevron && chevron.classList.toggle('rotate-180', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
